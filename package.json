{
  "name": "svoi-chat",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "setup-link": "node scripts/setup-link.mjs",
    "desktop": "electron desktop",
    "desktop:build:win": "node scripts/build-desktop.mjs win32",
    "desktop:build:exe": "npm run desktop:build:win && node scripts/build-portable.mjs",
    "desktop:smoke:win": "node scripts/smoke-portable.mjs",
    "desktop:build:linux": "node scripts/build-desktop.mjs linux",
    "cloud:dev": "wrangler dev --local",
    "cloud:build": "wrangler deploy --dry-run --outdir dist/worker",
    "deploy": "wrangler deploy",
    "cloud:connect": "node scripts/connect-service.mjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "miniflare": "5.20261019.2-beta",
    "wrangler": "4.152.0"
  }
}
