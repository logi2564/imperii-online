function R23_Trig_Debut_Actions takes nothing returns nothing
call PauseAllUnitsBJ(false)
call EnableTrigger(udg_R23_gg_trg_Revenus)
call CreateTimerDialogBJ(udg_R23_udg_Compteur1,"|CFF005B7FПрибыль :|r")
call StartTimerBJ(udg_R23_udg_Compteur1,true,15.)
endfunction

function R23_InitTrig_Debut takes nothing returns nothing
set udg_R23_gg_trg_Debut=CreateTrigger()
