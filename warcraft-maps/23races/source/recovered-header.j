function R23_Trig_Race_Conditions takes nothing returns boolean
return(GetSpellAbilityId()=='A065')
endfunction

function R23_Trig_Race_Func004A takes nothing returns nothing
call SetPlayerAbilityAvailableBJ(false,'A065',GetOwningPlayer(GetSpellAbilityUnit()))
endfunction

function R23_Trig_Race_Actions takes nothing returns nothing
set udg_R23_udg_Random_Hero=GetRandomInt(1,udg_R23_udg_Total_hero)
call RemoveUnit(GetSpellAbilityUnit())
call CreateNUnitsAtLoc(5,udg_R23_udg_Random_system[udg_R23_udg_Random_Hero],GetTriggerPlayer(),GetRectCenter(udg_R23_gg_rct_SpawnLocation),bj_UNIT_FACING)
call ForForce(udg_R23_udg_Players_hero,function R23_Trig_Race_Func004A)
set udg_R23_udg_Random_system[udg_R23_udg_Random_Hero]=udg_R23_udg_Random_system[udg_R23_udg_Total_hero]
set udg_R23_udg_Total_hero=(udg_R23_udg_Total_hero-1)
endfunction

function R23_InitTrig_Race takes nothing returns nothing
set udg_R23_gg_trg_Race=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(udg_R23_gg_trg_Race,EVENT_PLAYER_UNIT_SPELL_EFFECT)
