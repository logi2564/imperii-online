return(UnitHasBuffBJ(GetTriggerUnit(),'B000'))
endfunction

function R23_Trig_Production_en_chaine_Actions takes nothing returns nothing
call TriggerSleepAction(.1)
if(R23_Trig_Production_en_chaine_Func002C())then
call IssueImmediateOrderById(GetTriggerUnit(),GetUnitTypeId(GetTrainedUnit()))
endif
endfunction

