function R23_Trig_Declare_War_1_Func003001001 takes nothing returns boolean
return(GetPlayerAlliance(udg_R23_udg_Instagator,GetFilterPlayer(),ALLIANCE_PASSIVE)==false)
endfunction

function R23_Trig_Declare_War_1_Func003002001 takes nothing returns boolean
return(GetPlayerAlliance(GetEnumPlayer(),udg_R23_udg_Instagator,ALLIANCE_PASSIVE))
endfunction

function R23_Trig_Declare_War_1_Func003002 takes nothing returns nothing
if(R23_Trig_Declare_War_1_Func003002001())then
call DisplayTimedTextToForce(GetForceOfPlayer(GetEnumPlayer()),10.,(GetPlayerName(udg_R23_udg_Instagator)+" |c00FF0000Обьявил вам войну|r !"))
endif
endfunction

function R23_Trig_Declare_War_1_Func004001001 takes nothing returns boolean
return(GetPlayerAlliance(udg_R23_udg_Instagator,GetFilterPlayer(),ALLIANCE_PASSIVE)==false)
