function R23_Trig_Multiboard_Create_Actions takes nothing returns nothing
set udg_R23_udg_PlayersCount[1]=CountPlayersInForceBJ(udg_R23_udg_PlayersForce[1])
call CreateMultiboardBJ(7,14,"23 Расы: Multiboard
")
set udg_R23_udg_MultiBoard=bj_lastCreatedMultiboard
call MultiboardSetTitleTextColorBJ(udg_R23_udg_MultiBoard,40.,38.,39.,0)
set bj_forLoopAIndex=1
set bj_forLoopAIndexEnd=MultiboardGetRowCount(udg_R23_udg_MultiBoard)
loop
exitwhen bj_forLoopAIndex>bj_forLoopAIndexEnd
set bj_forLoopBIndex=1
set bj_forLoopBIndexEnd=MultiboardGetColumnCount(udg_R23_udg_MultiBoard)
loop
exitwhen bj_forLoopBIndex>bj_forLoopBIndexEnd
set bj_forLoopBIndex=bj_forLoopBIndex+1
endloop
call MultiboardSetItemWidthBJ(bj_lastCreatedMultiboard,1,bj_forLoopAIndex,6.)
call MultiboardSetItemColorBJ(udg_R23_udg_MultiBoard,4,bj_forLoopAIndex,100.,.0,.0,.0)
call MultiboardSetItemColorBJ(udg_R23_udg_MultiBoard,5,bj_forLoopAIndex,.0,.0,100.,.0)
call MultiboardSetItemColorBJ(udg_R23_udg_MultiBoard,6,bj_forLoopAIndex,100.,.0,.0,.0)
call MultiboardSetItemColorBJ(udg_R23_udg_MultiBoard,7,bj_forLoopAIndex,37.3,37.6,38.4,.0)
call MultiboardSetItemColorBJ(udg_R23_udg_MultiBoard,8,bj_forLoopAIndex,100.,100.,.0,.0)
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,2,"Игроки:")
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,3,("|c00FF0303"+GetPlayerName(Player(0))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,4,("|c000042FF"+GetPlayerName(Player(1))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,5,("|c001CE6B9"+GetPlayerName(Player(2))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,6,("|c00540081"+GetPlayerName(Player(3))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,7,("|c00FFFC01"+GetPlayerName(Player(4))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,8,("|c00fEBA0E"+GetPlayerName(Player(5))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,9,("|c0020C000"+GetPlayerName(Player(6))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,10,("|c00E55BB0"+GetPlayerName(Player(7))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,11,("|c00959697"+GetPlayerName(Player(8))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,12,("|c007EBFF1"+GetPlayerName(Player(9))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,13,("|c00106246"+GetPlayerName(Player(10))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,1,14,("|c004E2A04"+GetPlayerName(Player(11))))
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,4,1,"K")
call MultiboardSetItemValueBJ(udg_R23_udg_MultiBoard,5,1,"D")
