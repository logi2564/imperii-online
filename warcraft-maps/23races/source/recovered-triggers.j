set udg_R23_gg_trg_Production_en_chaine=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(udg_R23_gg_trg_Production_en_chaine,EVENT_PLAYER_UNIT_TRAIN_FINISH)
