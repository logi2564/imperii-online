function R23_Trig_Human_Conditions takes nothing returns boolean
return(GetResearched()=='R000')
endfunction

function R23_Trig_Human_Actions takes nothing returns nothing
call CreateNUnitsAtLoc(5,'hpea',GetOwningPlayer(GetTriggerUnit()),GetUnitLoc(GetTriggerUnit()),bj_UNIT_FACING)
call RemoveUnit(GetTriggerUnit())
call DisplayTimedTextToForce(bj_FORCE_ALL_PLAYERS,5.,(("Игрок "+GetPlayerName(GetTriggerPlayer()))+" выбрал расу - |c0020C000Люди|r"))
endfunction

function R23_InitTrig_Human takes nothing returns nothing
set udg_R23_gg_trg_Human=CreateTrigger()
call TriggerRegisterAnyUnitEventBJ(udg_R23_gg_trg_Human,EVENT_PLAYER_UNIT_RESEARCH_FINISH)
call TriggerAddCondition(udg_R23_gg_trg_Human,Condition(function R23_Trig_Human_Conditions))
