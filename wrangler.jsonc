{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svoi-chat-logi2564",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./chat",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "COMMUNITY", "class_name": "Community" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Community"] }],
}
